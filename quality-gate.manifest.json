{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Orchestration",
      "component": "self-service-experience",
      "promotionType": "other",
      "promotionTypeDetails": [
        "Only dev and production environments"
      ],
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.run-checkov"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.check-shell-scripts"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.check-linting"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.check-vulnerabilities"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.sonarcloud"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.run-unit-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/deploy-contract.yml",
          "path": "$.jobs.contract-testing"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/deploy-contract.yml",
          "path": "$.jobs.contract-testing"
        }
      ]
    }
  ]
}
