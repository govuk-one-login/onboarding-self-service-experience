{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "moduleResolution": "bundler",
    "removeComments": true,
    "noUnusedLocals": true,
    "outDir": "./dist",
    "rootDir": "./support",
    "noEmit": true
  },
  "include": ["support/**/*"],
  "exclude": ["node_modules"]
}
